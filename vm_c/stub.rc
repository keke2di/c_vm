#include <winver.h>
#include "stub_version.h"

1 24 "stub.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION CVM_VERSION_MAJOR,CVM_VERSION_MINOR,CVM_VERSION_PATCH,0
PRODUCTVERSION CVM_VERSION_MAJOR,CVM_VERSION_MINOR,CVM_VERSION_PATCH,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "cVM"
            VALUE "FileDescription", "cVM application"
            VALUE "FileVersion", CVM_VERSION_STRING
            VALUE "InternalName", "cvm-stub"
            VALUE "LegalCopyright", "Copyright (c) 2026 Keke"
            VALUE "OriginalFilename", "stub.exe"
            VALUE "ProductName", "cVM"
            VALUE "ProductVersion", CVM_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
